PORT=3333

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=mydb
DB_SSL=

# Endereco do front-end, usado no link do convite (APP_URL/convite/<token>)
APP_URL=http://localhost:5173

# SMTP para envio de e-mails. Sem SMTP_HOST, os e-mails vao para uma caixa
# de teste do Ethereal e o link para visualiza-los aparece no console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 e SMTP_PASS = senha de app
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Executavel do SWI-Prolog usado pelo motor de geracao (opcional).
# Vazio: usa o "swipl" do PATH. Ex.: C:\Program Files\swipl\bin\swipl.exe
SWIPL_PATH=
