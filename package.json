{
  "name": "back",
  "version": "1.0.0",
  "description": "Backend API - Express + TypeScript + MySQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/**/*.ts",
    "test": "node --require ./tests/registrar.js --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:prolog": "swipl -g run_tests -t halt prolog/testes/testes_alocacao.pl",
    "typecheck": "tsc --noEmit -p . && tsc -p tests/tsconfig.json",
    "bench": "ts-node -P tests/tsconfig.json scripts/benchmark.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.3",
    "mysql2": "^3.22.5",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.2",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
